---
import { catalogueFetchedAt } from "../lib/catalogue";
import "../styles.css";

type Props = { title: string; description?: string; narrow?: boolean };
const { title, description, narrow = false } = Astro.props;

const links = [
  { href: "/", label: "Start a plan" },
  { href: "/plans/example", label: "Example plan" },
  { href: "/majors/", label: "Majors" },
  { href: "/map/", label: "Course map" },
  { href: "/courses/", label: "Courses" },
  { href: "/readme/", label: "About" },
];
const path = Astro.url.pathname;
const current = (href: string) =>
  href === "/" ? path === "/" : path === href || (href.endsWith("/") && path.startsWith(href));
const read = new Date(catalogueFetchedAt).toLocaleDateString("en-AU", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Australia/Sydney",
});
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <a class="brand" href="/">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--accent)">
          <rect x="3" y="4" width="18" height="17" rx="2"></rect>
          <path d="M3 9h18M8 2v4M16 2v4M8 13h3M8 17h6"></path>
        </svg>
        <span class="brand-name">Semester Planner</span>
        <span class="brand-note">for ANU computing courses · unofficial</span>
      </a>
      <nav aria-label="Site">
        {links.map((link) => <a href={link.href} aria-current={current(link.href) ? "page" : undefined}>{link.label}</a>)}
      </nav>
    </header>
    <main id="main" class={narrow ? "narrow" : undefined}>
      <slot />
    </main>
    <footer class="site">
      <p>
        An unofficial student prototype, not an ANU system. Course and major data from{" "}
        <a href="https://programsandcourses.anu.edu.au/">ANU Programs and Courses</a>, read on {read}.
        Check anything that matters with P&amp;C or ANU Student Hubs.
      </p>
    </footer>
  </body>
</html>
