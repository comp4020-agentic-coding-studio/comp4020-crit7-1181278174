---
import Layout from "../../layouts/Layout.astro";
import { allMajors } from "../../lib/majors";

const summary = allMajors.map((m) => {
  const compulsory = m.blocks.filter((b) => b.kind === "compulsory").reduce((sum, b) => sum + (b.units ?? 0), 0);
  const listed = new Set(m.blocks.flatMap((b) => b.courses.map((c) => c.code))).size;
  return { ...m, compulsory, listed };
});
---

<Layout title="Computing majors · Semester Planner" description="The computing majors' 2027 requirements, as P&C lists them.">
  <h1>Computing majors</h1>
  <p class="lede">
    The seven computing majors P&amp;C lists for the Bachelor of Computing, with the courses each one
    requires in 2027. Open one to see its lists, when each course runs, and which of them a plan
    already has.
  </p>
  <ul class="majors-grid">
    {
      summary.map((m) => (
        <li>
          <a class="major-card" href={`/majors/${m.code}`}>
            <span class="code">{m.code}</span>
            <span class="name">{m.title}</span>
            <span class="meta">
              {m.compulsory} units compulsory · {m.listed} courses listed
            </span>
          </a>
        </li>
      ))
    }
    <li class="help" style="border: 1px dashed var(--field); border-radius: 12px; padding: 18px 20px">
      Requirements are quoted from P&amp;C. The planner shows them and marks what a plan has; it does
      not decide whether a major is complete.
    </li>
  </ul>
</Layout>
