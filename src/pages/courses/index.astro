---
import Layout from "../../layouts/Layout.astro";
import { catalogue } from "../../lib/catalogue";
import { runsText } from "../../lib/map";

const courses = [...catalogue.courses.values()];
const changing = new Set(
  courses
    .filter((c) => new Set(catalogue.years.map((y) => (c.offerings[y] ?? []).join())).size > 1)
    .map((c) => c.code),
);
const levels = [1000, 2000, 3000, 4000].map((level) => ({ level, courses: courses.filter((c) => c.level === level) }));
---

<Layout title="Courses · Semester Planner" description="The courses this planner checks, with the semesters each runs in from 2026 to 2028.">
  <h1>The courses this planner knows</h1>
  <p class="lede">
    {courses.length} courses: the undergraduate COMP courses, and the MATH, ENGN and INFS courses their
    prerequisites name. {changing.size} of them run in different semesters from one year to the next,
    marked below. Offerings for {catalogue.years.slice(1).join(" and ")} are what P&amp;C lists now,
    which it calls indicative.
  </p>
  <div class="level-cols" style="margin-top: 24px">
    {
      levels.map(({ level, courses: list }) => (
        <section aria-labelledby={`lv-${level}`}>
          <h2 id={`lv-${level}`}>{level}-level</h2>
          <ul>
            {list.map((c) => (
              <li>
                <a class="node" href={`/courses/${c.code}`}>
                  <span class="code">{c.code}</span>
                  <span>{c.title}</span>
                  <span class="sub">
                    {runsText(c)}
                    {changing.has(c.code) && " · changes between years"}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
