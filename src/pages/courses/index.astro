---
import Layout from "../../layouts/Layout.astro";
import { catalogue } from "../../lib/catalogue";

const sessionsText = (sessions: string[] | undefined) =>
  sessions?.length ? sessions.join(" and ") : "not offered";
const courses = [...catalogue.courses.values()];
const changing = courses.filter((c) => {
  const patterns = catalogue.years.map((y) => (c.offerings[y] ?? []).join());
  return new Set(patterns).size > 1;
});
---

<Layout
  title="Courses · Semester planner"
  description="The courses this planner checks, with the semesters each runs in from 2026 to 2028."
>
  <h1>The courses this planner knows</h1>
  <p>
    {courses.length} courses: the undergraduate COMP courses, and the MATH, ENGN and INFS courses their
    prerequisites name. {changing.length} of them run in different semesters from one year to the next,
    marked below. Offerings for {catalogue.years.slice(1).join(" and ")} are what P&amp;C lists now,
    which it calls indicative.
  </p>
  <ul class="catalogue">
    {
      courses.map((course) => (
        <li>
          <a href={`/courses/${course.code}`}>{course.code}</a> {course.title}
          {changing.includes(course) && <strong> · changes between years</strong>}
          <span class="runs">
            {catalogue.years.map((year) => `${year}: ${sessionsText(course.offerings[year])}`).join(" · ")}
          </span>
        </li>
      ))
    }
  </ul>
</Layout>
